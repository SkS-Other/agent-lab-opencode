{
  "name": "agent-lab-opencode",
  "version": "0.1.0",
  "description": "CLI-driven, OpenCode-centered experiment runner: vary system prompt / model / task prompt, run isolated in Docker, capture and compare agent behavior.",
  "license": "MIT",
  "author": "ShutovKS",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShutovKS/agent-lab-opencode.git"
  },
  "homepage": "https://github.com/ShutovKS/agent-lab-opencode#readme",
  "keywords": ["agent", "lab", "llm", "orchestration", "sandbox", "prompt", "opencode", "mcp", "docker"],
  "type": "module",
  "module": "src/cli/index.ts",
  "bin": {
    "agent-lab": "dist/bin/agent-lab.js",
    "agent-lab-mcp": "dist/bin/agent-lab-mcp.js"
  },
  "files": ["dist", "docs", "docker", "README.md", "LICENSE"],
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "bun build --target=node --packages=external --outdir=dist/bin src/bin/agent-lab.ts src/bin/agent-lab-mcp.ts",
    "compile": "bun build --compile --outfile=bin/agent-lab src/bin/agent-lab.ts && bun build --compile --outfile=bin/agent-lab-mcp src/bin/agent-lab-mcp.ts",
    "prepare": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opencode-ai/sdk": "^1.17.11",
    "microsandbox": "^0.6.1",
    "pino": "^9.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.0.0"
  }
}
